# No automatic hosted fallback. Set explicitly when running a live profile.
ACCESSFLOW_BACKEND=ollama
ACCESSFLOW_OLLAMA_URL=http://localhost:11434
ACCESSFLOW_OLLAMA_MODEL=gemma3:4b
# Optional explicit layer placement; omit for Ollama auto, 0 for CPU, -1 for auto.
# ACCESSFLOW_OLLAMA_NUM_GPU=35
# ACCESSFLOW_GEMINI_API_KEY=
ACCESSFLOW_GEMINI_MODEL=gemini-2.5-flash-lite

# Groq hosted profile. Create the key at console.groq.com and keep it out of Git.
# Verify the model id against Groq's current model list before a scored run.
# ACCESSFLOW_GROQ_API_KEY=
ACCESSFLOW_GROQ_MODEL=llama-3.3-70b-versatile
ACCESSFLOW_GROQ_URL=https://api.groq.com/openai/v1
# Set to 1 for strict json_schema output; default json_object keeps the schema in the prompt.
# ACCESSFLOW_GROQ_STRUCTURED=1

# NVIDIA NIM hosted profile (OpenAI-compatible). Key from build.nvidia.com.
# ACCESSFLOW_NVIDIA_API_KEY=
ACCESSFLOW_NVIDIA_MODEL=google/gemma-4-31b-it
ACCESSFLOW_NVIDIA_URL=https://integrate.api.nvidia.com/v1
# ACCESSFLOW_NVIDIA_STRUCTURED=1

# Ollama reasoning models emit a think block that exceeds planning deadlines.
ACCESSFLOW_OLLAMA_THINK=0
