# Template only. Copy to .env, which is gitignored, and never commit a real key.
# The CLI does NOT read .env. Export these into the shell yourself.
# See docs/PROFILES.md for the complete, measured profiles.

# No automatic hosted fallback. Set the backend explicitly for every live run.
ACCESSFLOW_BACKEND=ollama

# --- Profile: hosted-qwen (primary) -----------------------------------------
# ACCESSFLOW_GROQ_API_KEY=
ACCESSFLOW_GROQ_MODEL=qwen/qwen3.8-27b
ACCESSFLOW_GROQ_URL=https://api.groq.com/openai/v1
# Required for qwen3.8-27b. Groq refuses the request at admission without it, because the
# adapter otherwise sends no max_tokens and the model's default ceiling of 1990 exceeds the
# 1000 output-tokens-per-minute budget. The check is per request, so pacing does not help.
ACCESSFLOW_MAX_OUTPUT_TOKENS=950
# Set to 1 for strict json_schema output; default json_object keeps the schema in the prompt.
# ACCESSFLOW_GROQ_STRUCTURED=1

# --- Profile: local-qwen3-4b ------------------------------------------------
# Use the port printed by scripts/start-local-ollama.ps1, not the default 11434.
ACCESSFLOW_OLLAMA_URL=http://127.0.0.1:11435
ACCESSFLOW_OLLAMA_MODEL=qwen3:4b
# Reasoning models emit a think block that exceeds planning deadlines.
ACCESSFLOW_OLLAMA_THINK=0
# Pin the layer count for qwen3:4b on a 4096 MiB card and for no other model. Automatic
# fitting keeps a 1024 MiB free-memory reserve and silently drops to 29 of 37 layers when a
# full offload does not clear it. Confirm "offloaded 37/37 layers to GPU" in the server log
# before recording any local score. A stale pin once made qwen2.5:7b overflow the card.
ACCESSFLOW_OLLAMA_NUM_GPU=37
# Start the server with: scripts/start-local-ollama.ps1 -FlashAttention 1 -KvCacheType q8_0

# --- Other backends ---------------------------------------------------------
# ACCESSFLOW_GEMINI_API_KEY=
ACCESSFLOW_GEMINI_MODEL=gemini-2.5-flash-lite
# NVIDIA NIM (OpenAI-compatible). Key from build.nvidia.com.
# ACCESSFLOW_NVIDIA_API_KEY=
ACCESSFLOW_NVIDIA_MODEL=google/gemma-4-31b-it
ACCESSFLOW_NVIDIA_URL=https://integrate.api.nvidia.com/v1
# ACCESSFLOW_NVIDIA_STRUCTURED=1
