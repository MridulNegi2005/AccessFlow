{
  "id": "live-dev-support-read-then-service",
  "provenance": "Codex-authored live-development variant of support_then_service.json; explicit tool formats and model-sized timeout. Not held out; mock effects only.",
  "completion_timeout_s": 100,
  "events": [
    {
      "kind": "session_start",
      "session_id": "support",
      "payload": {
        "tools": [
          {
            "name": "inspect_support_notes",
            "description": "Read the fictional support instructions for a symptom",
            "effect": "read",
            "parameters": {
              "type": "object",
              "properties": {
                "symptom": {
                  "type": "string",
                  "description": "Canonical symptom category.",
                  "enum": [
                    "flicker"
                  ]
                }
              },
              "required": [
                "symptom"
              ],
              "additionalProperties": false
            }
          },
          {
            "name": "file_visit_request",
            "description": "Create a mock device service visit",
            "effect": "write",
            "idempotency_parameter": "request_token",
            "parameters": {
              "type": "object",
              "properties": {
                "device": {
                  "type": "string"
                },
                "day": {
                  "type": "string"
                },
                "hour": {
                  "type": "string",
                  "description": "Local time in 24-hour HH:MM format, for example 09:30.",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "request_token": {
                  "type": "string"
                }
              },
              "required": [
                "device",
                "day",
                "hour",
                "request_token"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    {
      "kind": "transcript",
      "session_id": "support",
      "event_id": "support-request",
      "payload": {
        "utterance_id": "u1",
        "revision": 0,
        "final": true,
        "text": "My Panel-A screen still flickers after restarting. Check the support notes and book a Wednesday five PM visit if service is recommended."
      }
    }
  ],
  "environment": {
    "inspect_support_notes": {
      "kind": "lookup",
      "identity_fields": [
        "symptom"
      ],
      "rows": [
        {
          "symptom": "flicker",
          "document": "fictional-panel-a-support",
          "recommendation": "Service visit after restart did not resolve flickering"
        }
      ]
    },
    "file_visit_request": {
      "kind": "write",
      "identity_fields": [
        "device",
        "day",
        "hour"
      ],
      "mode": "reservation"
    }
  },
  "reasoning_steps": [
    {
      "input_event_id": "support-request",
      "proposal": {
        "intent": "service",
        "slot_updates": {
          "device": "Panel-A",
          "day": "Wednesday",
          "hour": "17:00",
          "symptom": "flicker"
        },
        "calls": [
          {
            "tool": "inspect_support_notes",
            "arguments": {
              "symptom": "flicker"
            },
            "dependencies": [
              "symptom",
              "device"
            ]
          }
        ],
        "write_requested": true
      }
    },
    {
      "input_event_id": "support-request",
      "after_tools": {
        "inspect_support_notes": "success"
      },
      "proposal": {
        "request_complete": true,
        "write_requested": true,
        "calls": [
          {
            "tool": "file_visit_request",
            "arguments": {
              "device": "Panel-A",
              "day": "Wednesday",
              "hour": "17:00"
            },
            "dependencies": [
              "device",
              "day",
              "hour"
            ]
          }
        ]
      }
    }
  ],
  "expected_slots": {
    "device": "Panel-A",
    "day": "Wednesday",
    "hour": "17:00"
  },
  "expectation": {
    "slots": {
      "device": "Panel-A",
      "day": "Wednesday",
      "hour": "17:00"
    },
    "effects": [
      {
        "tool": "file_visit_request",
        "arguments": {
          "device": "Panel-A",
          "day": "Wednesday",
          "hour": "17:00"
        }
      }
    ],
    "final_basis": "confirmed_tool_effect"
  }
}
