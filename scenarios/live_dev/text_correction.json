{
  "id": "live-dev-development-text-correction-01",
  "provenance": "Codex-authored live-development variant of text_correction.json; explicit tool formats and model-sized timeout. Not held out; mock effects only.",
  "event_spacing_s": 0.05,
  "expected_slots": {
    "day": "Wednesday",
    "hour": "17:00"
  },
  "expectation": {
    "slots": {
      "day": "Wednesday",
      "hour": "17:00"
    },
    "effects": [
      {
        "tool": "reserve_service_slot",
        "arguments": {
          "day": "Wednesday",
          "hour": "17:00"
        }
      }
    ],
    "final_basis": "confirmed_tool_effect"
  },
  "environment": {
    "reserve_service_slot": {
      "kind": "write",
      "identity_fields": [
        "day",
        "hour"
      ]
    }
  },
  "events": [
    {
      "kind": "session_start",
      "session_id": "demo",
      "payload": {
        "tools": [
          {
            "name": "reserve_service_slot",
            "description": "Create one mock device service appointment",
            "effect": "write",
            "parameters": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "string"
                },
                "hour": {
                  "type": "string",
                  "description": "Local time in 24-hour HH:MM format, for example 09:30.",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "day",
                "hour"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    {
      "kind": "transcript",
      "session_id": "demo",
      "sequence": 1,
      "payload": {
        "utterance_id": "u1",
        "revision": 0,
        "text": "Book Tues ...",
        "final": false
      }
    },
    {
      "kind": "transcript",
      "session_id": "demo",
      "sequence": 2,
      "payload": {
        "utterance_id": "u1",
        "revision": 1,
        "text": "Book Tuesday, actually Wednesday at five PM",
        "final": true
      }
    }
  ],
  "proposals": [
    {
      "intent": "service_appointment",
      "slot_updates": {
        "day": "Tuesday"
      }
    },
    {
      "intent": "service_appointment",
      "slot_updates": {
        "day": "Wednesday",
        "hour": "17:00"
      },
      "request_complete": true,
      "write_requested": true,
      "calls": [
        {
          "tool": "reserve_service_slot",
          "arguments": {
            "day": "Wednesday",
            "hour": "17:00"
          },
          "dependencies": [
            "day",
            "hour"
          ]
        }
      ]
    }
  ],
  "completion_timeout_s": 100
}
