{
  "id": "planner-probe-fluent-noon",
  "provenance": "Independently drafted AI development probe for AccessFlow Workstream A; mock service scheduling only, not teammate-heldout and not a clinical case.",
  "completion_timeout_s": 100,
  "expected_slots": {
    "product_code": "VelaPanel-3",
    "weekday": "Friday",
    "time_24h": "12:00"
  },
  "expectation": {
    "slots": {
      "product_code": "VelaPanel-3",
      "weekday": "Friday",
      "time_24h": "12:00"
    },
    "effects": [
      {
        "tool": "queue_technician_visit",
        "arguments": {
          "product_code": "VelaPanel-3",
          "weekday": "Friday",
          "time_24h": "12:00"
        }
      }
    ],
    "final_basis": "confirmed_tool_effect"
  },
  "environment": {
    "queue_technician_visit": {
      "kind": "write",
      "mode": "reservation",
      "identity_fields": ["product_code", "weekday", "time_24h"]
    }
  },
  "events": [
    {
      "kind": "session_start",
      "session_id": "fluent-noon",
      "payload": {
        "tools": [
          {
            "name": "queue_technician_visit",
            "description": "Create one fictional service appointment for a product.",
            "effect": "write",
            "idempotency_parameter": "reservation_tag",
            "parameters": {
              "type": "object",
              "properties": {
                "product_code": {
                  "type": "string",
                  "enum": ["VelaPanel-3", "VelaPanel-4"]
                },
                "weekday": {
                  "type": "string",
                  "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
                },
                "time_24h": {
                  "type": "string",
                  "description": "Local time as 24-hour HH:MM; noon is represented as 12:00.",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "reservation_tag": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,64}$"
                }
              },
              "required": ["product_code", "weekday", "time_24h", "reservation_tag"],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    {
      "kind": "transcript",
      "session_id": "fluent-noon",
      "event_id": "fluent-request",
      "sequence": 1,
      "payload": {
        "utterance_id": "u1",
        "revision": 0,
        "text": "Could you arrange a service appointment for VelaPanel-3 this Friday at 12 PM, meaning noon and therefore 12:00 in 24-hour time? Please confirm once it is booked.",
        "final": true
      }
    }
  ],
  "proposals": [
    {
      "intent": "service_appointment",
      "slot_updates": {
        "product_code": "VelaPanel-3",
        "weekday": "Friday",
        "time_24h": "12:00"
      },
      "request_complete": true,
      "write_requested": true,
      "calls": [
        {
          "tool": "queue_technician_visit",
          "arguments": {
            "product_code": "VelaPanel-3",
            "weekday": "Friday",
            "time_24h": "12:00"
          },
          "dependencies": ["product_code", "weekday", "time_24h"]
        }
      ]
    }
  ]
}
