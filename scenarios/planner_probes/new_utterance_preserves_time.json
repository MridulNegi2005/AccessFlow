{
  "id": "planner-probe-new-utterance-preserves-time",
  "provenance": "Independently drafted AI development probe for AccessFlow Workstream A; mock service scheduling only, not teammate-heldout and not a clinical case.",
  "event_spacing_s": 0.04,
  "completion_timeout_s": 100,
  "expected_slots": {
    "target_id": "AsterSlate-5",
    "day_name": "Thursday",
    "local_start": "08:15"
  },
  "expectation": {
    "slots": {
      "target_id": "AsterSlate-5",
      "day_name": "Thursday",
      "local_start": "08:15"
    },
    "effects": [
      {
        "tool": "commit_care_window",
        "arguments": {
          "target_id": "AsterSlate-5",
          "day_name": "Thursday",
          "local_start": "08:15"
        }
      }
    ],
    "final_basis": "confirmed_tool_effect"
  },
  "environment": {
    "commit_care_window": {
      "kind": "write",
      "mode": "reservation",
      "identity_fields": ["target_id", "day_name", "local_start"],
      "commit_delay_s": 0.25
    }
  },
  "events": [
    {
      "kind": "session_start",
      "session_id": "new-utterance-correction",
      "payload": {
        "tools": [
          {
            "name": "commit_care_window",
            "description": "Create one fictional service appointment for a target device.",
            "effect": "write",
            "idempotency_parameter": "request_fingerprint",
            "parameters": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string",
                  "enum": ["AsterSlate-4", "AsterSlate-5"]
                },
                "day_name": {
                  "type": "string",
                  "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
                },
                "local_start": {
                  "type": "string",
                  "description": "Local start in 24-hour HH:MM format, including a leading zero.",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "request_fingerprint": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,64}$"
                }
              },
              "required": ["target_id", "day_name", "local_start", "request_fingerprint"],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    {
      "kind": "transcript",
      "session_id": "new-utterance-correction",
      "event_id": "original-window",
      "sequence": 1,
      "payload": {
        "utterance_id": "u1",
        "revision": 0,
        "text": "Please arrange a service visit for AsterSlate-4 on Thursday at 08:15 local time.",
        "final": true
      }
    },
    {
      "kind": "transcript",
      "session_id": "new-utterance-correction",
      "event_id": "replacement-window",
      "sequence": 2,
      "payload": {
        "utterance_id": "u2",
        "revision": 0,
        "text": "Correction in a new utterance: use AsterSlate-5 instead, while keeping Thursday at 08:15 local time unchanged.",
        "final": true
      }
    }
  ],
  "proposals": [
    {
      "intent": "service_appointment",
      "slot_updates": {
        "target_id": "AsterSlate-4",
        "day_name": "Thursday",
        "local_start": "08:15"
      },
      "request_complete": true,
      "write_requested": true,
      "calls": [
        {
          "tool": "commit_care_window",
          "arguments": {
            "target_id": "AsterSlate-4",
            "day_name": "Thursday",
            "local_start": "08:15"
          },
          "dependencies": ["target_id", "day_name", "local_start"]
        }
      ]
    },
    {
      "intent": "service_appointment",
      "slot_updates": {
        "target_id": "AsterSlate-5",
        "day_name": "Thursday",
        "local_start": "08:15"
      },
      "request_complete": true,
      "write_requested": true,
      "calls": [
        {
          "tool": "commit_care_window",
          "arguments": {
            "target_id": "AsterSlate-5",
            "day_name": "Thursday",
            "local_start": "08:15"
          },
          "dependencies": ["target_id", "day_name", "local_start"]
        }
      ]
    }
  ]
}
