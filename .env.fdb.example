# Copy outside this repository to the pinned official v3/.env.local.
# Never commit the populated file. Existing process settings take precedence.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ACCESSFLOW_GROQ_API_KEY=
OPENAI_API_KEY=

FDB_PLANNER_PROVIDER=livekit
FDB_LIVEKIT_MODEL=openai/gpt-5.6-luna
FDB_GROQ_MODEL=qwen/qwen3.8-27b
FDB_GROQ_STT_MODEL=whisper-large-v3
FDB_TTS_PROVIDER=livekit
FDB_PROMPT_PROFILE=compact-v2
FDB_LATENCY_PROFILE=instant
ACCESSFLOW_MAX_OUTPUT_TOKENS=950
ACCESSFLOW_MAX_CONTEXT_CHARS=32768
ACCESSFLOW_GROQ_STRUCTURED=0
